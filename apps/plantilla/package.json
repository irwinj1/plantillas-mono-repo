{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "plantilla",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve --port=8005\" \"php artisan queue:listen --tries=1 --timeout=0\" \"vite\" --names='server,queue,vite'",
        "setup": "composer install"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
